# PostgreSQL connection string
DATABASE_URL=postgresql://godjumo@localhost:5432/lecturaai

# STT provider: whisper | deepgram | whispercpp
#   whisper    — OpenAI Whisper API (production, per-minute billing)
#   whispercpp — local whisper.cpp, no API cost (testing/dev)
STT_PROVIDER=whisper

# OpenAI (Whisper STT + LLM summarization)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# LLM endpoint override (unset -> falls back to OPENAI_BASE_URL / OPENAI_API_KEY)
# Local testing with Ollama (no API cost):
#   brew install ollama && ollama serve
#   ollama pull exaone3.5:7.8b && ollama create lectura-exaone -f ollama/Modelfile
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=lectura-exaone
#LLM_BASE_URL=
#LLM_API_KEY=

# Deepgram (used when STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=

# whisper.cpp (used when STT_PROVIDER=whispercpp)
#   install : brew install whisper-cpp
#   model   : mkdir -p storage/models && curl -L -o storage/models/ggml-large-v3-turbo.bin \
#               https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=./storage/models/ggml-large-v3-turbo.bin

# Local storage paths (relative paths resolve from project root)
UPLOAD_DIR=./storage/uploads
AUDIO_DIR=./storage/audio

# Max upload size in megabytes
MAX_UPLOAD_MB=2048
