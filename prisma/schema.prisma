generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  UPLOADED
  EXTRACTING_METADATA
  EXTRACTING_AUDIO
  TRANSCRIBING
  CHUNKING
  SUMMARIZING
  GENERATING_RESULT
  COMPLETED
  FAILED
}

model Video {
  id           String        @id @default(cuid())
  originalName String
  mimeType     String
  sizeBytes    BigInt
  filePath     String
  audioPath    String?
  durationSec  Float?
  width        Int?
  height       Int?
  codec        String?
  createdAt    DateTime      @default(now())
  transcript   Transcript?
  summary      Summary?
  job          ProcessingJob?
}

model Transcript {
  id        String   @id @default(cuid())
  videoId   String   @unique
  language  String?
  segments  Json
  fullText  String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model ProcessingJob {
  id           String    @id @default(cuid())
  videoId      String    @unique
  status       JobStatus @default(UPLOADED)
  progress     Int       @default(0)
  errorMessage String?
  attempts     Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Summary {
  id        String   @id @default(cuid())
  videoId   String   @unique
  data      Json
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}
